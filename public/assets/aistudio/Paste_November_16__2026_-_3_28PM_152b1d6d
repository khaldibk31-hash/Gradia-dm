    async function uploadStoreImage(file, maxWidth) {
      if (!file || !file.type || !file.type.startsWith("image/")) throw new Error("اختاري ملف صورة صالحاً.");
      if (file.size > 12 * 1024 * 1024) throw new Error("حجم الصورة كبير. اختاري صورة أقل من 12 ميغابايت.");
      if (!sb) throw new Error("الاتصال بقاعدة البيانات غير جاهز.");
      const { data: sessionData } = await sb.auth.getSession();
      if (!sessionData || !sessionData.session) throw new Error("سجّلي الدخول إلى لوحة الإدارة أولاً.");
      const dataUrl = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = () => reject(new Error("تعذر قراءة الصورة."));
        reader.onload = ev => resolve(ev.target.result);
        reader.readAsDataURL(file);
      });
      const image = await new Promise((resolve, reject) => {
        const img = new Image(); img.onload = () => resolve(img); img.onerror = () => reject(new Error("صيغة الصورة غير مدعومة.")); img.src = dataUrl;
      });
      const ratio = Math.min(1, maxWidth / image.width);
      const canvas = document.createElement("canvas");
      canvas.width = Math.max(1, Math.round(image.width * ratio));
      canvas.height = Math.max(1, Math.round(image.height * ratio));
      const context = canvas.getContext("2d");
      if (!context) throw new Error("تعذر تجهيز الصورة على هذا الجهاز.");
      context.drawImage(image, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise((resolve, reject) => canvas.toBlob(b => b ? resolve(b) : reject(new Error("تعذر ضغط الصورة.")), "image/jpeg", 0.78));
      const safeName = Date.now() + "-" + Math.random().toString(36).slice(2, 9) + ".jpg";
      const path = "store/" + safeName;
      const { error } = await sb.storage.from("store-images").upload(path, blob, { contentType: "image/jpeg", upsert: false });
      if (error) throw error;
      const { data } = sb.storage.from("store-images").getPublicUrl(path);
      if (!data || !data.publicUrl) throw new Error("تم رفع الصورة لكن تعذر إنشاء رابطها.");
      return data.publicUrl;
    }

    async function setLogo(e) {
      const f = e.target.files && e.target.files[0]; if (!f) return;
      try {
        const url = await uploadStoreImage(f, 500);
        const logo = document.getElementById("site-logo");
        logo.src = url; logo.style.display = "block";
      } catch (err) { alert("تعذر رفع الشعار: " + err.message); }
      finally { e.target.value = ""; }
    }

    async function setStudioImg(e) {
      const f = e.target.files && e.target.files[0]; if (!f) return;
      try {
        const url = await uploadStoreImage(f, 1200);
        const target = document.getElementById("studio-preview");
        if (target) { target.style.backgroundImage = `linear-gradient(rgba(255,255,255,.15),rgba(255,255,255,.15)),url("${url}")`; target.style.backgroundSize = "cover"; target.style.backgroundPosition = "center"; }
      } catch (err) { alert("تعذر رفع صورة المعاينة: " + err.message); }
      finally { e.target.value = ""; }
    }

    function triggerCardImg(btn) {
      activeCard = btn.closest(".p-card");
      const inp = document.getElementById("card-img-in");
      inp.value = ""; inp.click();
    }

    async function applyCardImg(e) {
      const f = e.target.files && e.target.files[0]; if (!f || !activeCard) return;
      try {
        const url = await uploadStoreImage(f, 900);
        const wrap = activeCard.querySelector(".img-wrap");
        wrap.innerHTML = `<img src="${url}" class="p-img" alt="صورة المنتج"><button class="chg-img-btn edit-tool" onclick="triggerCardImg(this)">+ صورة</button>`;
      } catch (err) { alert("تعذر رفع صورة المنتج: " + err.message); }
      finally { e.target.value = ""; activeCard = null; }
    }

    function filterBranch(btn, secId, branch) {
      btn.parentElement.querySelectorAll(".tab-pill").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      document.querySelectorAll("#" + secId + " .p-card").forEach(c => {
        c.style.display = (branch === "all" || c.dataset.branch === branch) ? "flex" : "none";
      });
    }

    function updateCardPrice(sel) {
      const card = sel.closest(".p-card");
      const price = card && card.querySelector(".price");
      if (price) price.innerText = (Number(sel.value) || 0).toLocaleString("en-US") + " دج";
    }

    function openProdModal(id) { curSec = id; document.getElementById("prod-modal").style.display = "flex"; }

    function escapeHTML(value) {
      return String(value).replace(/[&<>"']/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]));
    }

    async function saveProd() {
      const br = document.getElementById("p-branch").value.trim() || "عام";
      const nm = document.getElementById("p-name").value.trim() || "منتج جديد";
      const ds = document.getElementById("p-desc").value.trim() || "تفاصيل المنتج حسب الطلب";
      const pr = Math.max(0, Number(document.getElementById("p-price").value) || 0);
      const optionsRaw = document.getElementById("p-options").value.trim();
      const options = optionsRaw.split("\n").map(line => line.split("|")).filter(parts => parts.length >= 2 && parts[0].trim() && Number.isFinite(Number(parts[1].trim()))).map(parts => ({label:parts[0].trim(),price:Math.max(0,Number(parts[1].trim()))}));
      const file = document.getElementById("p-img").files[0];
      const addButton = document.querySelector('#prod-modal button[onclick="saveProd()"]');
      if (addButton) { addButton.disabled = true; addButton.textContent = "جاري الإضافة..."; }
      try {
        let imageHTML = '<span>🎓</span>';
        if (file) {
          const url = await uploadStoreImage(file, 900);
          imageHTML = `<img src="${url}" class="p-img" alt="${escapeHTML(nm)}">`;
        }
        const g = document.querySelector("#" + curSec + " .prod-grid");
        if (!g) throw new Error("لم يتم العثور على قسم المنتجات.");
        const d = document.createElement("div"); d.className = "p-card"; d.dataset.branch = br;
        const optionHTML = options.length ? `<div class="p-opts"><select onchange="updateCardPrice(this)">${options.map(o=>`<option value="${o.price}">${escapeHTML(o.label)} (${o.price.toLocaleString("en-US")} دج)</option>`).join("")}</select></div>` : "";
        d.innerHTML = `<button class="del-btn edit-tool" onclick="this.closest('.p-card').remove()">×</button><div class="img-wrap">${imageHTML}<button class="chg-img-btn edit-tool" onclick="triggerCardImg(this)">+ صورة</button></div><div class="p-body"><span class="p-tag" data-edit="1">${escapeHTML(br)}</span><h4 class="p-title" data-edit="1">${escapeHTML(nm)}</h4><p style="font-size:.82rem;color:var(--muted);margin-bottom:8px;" data-edit="1">${escapeHTML(ds)}</p>${optionHTML}<div style="display:flex;justify-content:space-between;align-items:center;"><b class="price" style="color:var(--accent);" data-edit="1">${(options.length ? options[0].price : pr).toLocaleString("en-US")} دج</b><button class="btn-gold" style="padding:6px 14px;font-size:.8rem;" onclick="addCart(this)">أضف للسلة</button></div></div>`;
        g.appendChild(d); enableAdminUI(); closeAll();
        ["p-branch","p-name","p-desc","p-price","p-options"].forEach(id=>document.getElementById(id).value="");
        document.getElementById("p-img").value="";
      } catch (err) { alert("تعذرت إضافة المنتج: " + err.message); }
      finally { if (addButton) { addButton.disabled = false; addButton.textContent = "إضافة"; } }
    }

    function addCart(btn) {
      const c = btn.closest(".p-card");
      const t = c.querySelector(".p-title").innerText;
      const opts = Array.from(c.querySelectorAll("select")).map(function(s) { return s.options[s.selectedIndex].text; }).join(" - ");
      const p = parseInt(c.querySelector(".price").innerText.replace(/[^\d]/g, "")) || 0;
const capCol = c.dataset.capColor ? " | لون: " + c.dataset.capColor : "";
const sizeIn = c.querySelector(".cap-size-in");

const capSize = (sizeIn && sizeIn.value.trim()) ? " | مقاس الرأس: " + sizeIn.value.trim() + " سم" : "";
cart.push({ title: (opts ? t + " (" + opts + ")" : t) + capCol + capSize, price: p });


      document.getElementById("c-cnt").innerText = cart.length;
      alert("تمت الإضافة للسلة 🛍");
    }

    function openCart() {
      const l = document.getElementById("c-list"); l.innerHTML = ""; let tot = 0;
      cart.forEach(function(it, i) {
        tot += Number(it.price) || 0;
        const row = document.createElement("div");
        row.style.cssText = "display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);";
        const label = document.createElement("span");
        label.textContent = it.title + " (" + Number(it.price || 0).toLocaleString("en-US") + " دج)";
        const remove = document.createElement("button");
        remove.type = "button"; remove.textContent = "حذف";
        remove.style.cssText = "color:#b42318;background:transparent;border:0;cursor:pointer;font-weight:800;";
        remove.addEventListener("click", function() { cart.splice(i, 1); document.getElementById("c-cnt").innerText = cart.length; openCart(); });
        row.append(label, remove); l.appendChild(row);
      });
      if (!cart.length) l.innerHTML = "السلة فارغة حالياً";
      document.getElementById("c-tot").innerText = tot + " دج";
      document.getElementById("cart-modal").style.display = "flex";
    }

    function closeAll() { document.querySelectorAll(".modal").forEach(function(m) { m.style.display = "none"; }); }

    function sendWA() {
      if (!cart.length) return alert("السلة فارغة!");
      const nameInput = document.getElementById("u-name");
      const nm = nameInput.value.trim();
      if (!nm) { alert("من فضلك أدخلي الاسم الكامل."); nameInput.focus(); return; }
      const wl = document.getElementById("u-wilaya").value || "غير محدد";
      const dt = document.getElementById("u-date").value || "أقرب موعد";
      const nt = document.getElementById("u-note").value || "";
      let tot = 0, txt = "";
      cart.forEach(function(it, i) { tot += it.price; txt += (i+1) + ". " + it.title + " (" + it.price + " دج)\n"; });
      
      const msg = `*طلب جديد عبر الموقع 🎓*%0A` +
                  `👤 *الاسم:* ${nm}%0A` +
                  `📍 *الولاية:* ${wl}%0A` +
                  `📅 *موعد التسليم:* ${dt}%0A` +
                  `🛒 *الطلبات:*%0A${txt}` +
                  `💰 *المجموع التقديري:* ${tot} دج%0A` +
                  `📝 *ملاحظات:* ${nt}`;
                  
      const waUrl = `https://wa.me/${MY_WHATSAPP}?text=${encodeURIComponent(msg.replaceAll("%0A", "\n"))}`;
      const opened = window.open(waUrl, "_blank", "noopener,noreferrer");
      if (!opened) alert("المتصفح منع فتح واتساب. اسمحي بالنوافذ المنبثقة أو انسخي الطلب وحاولي مجدداً.");
    }
  </script>
</body>
</html>
