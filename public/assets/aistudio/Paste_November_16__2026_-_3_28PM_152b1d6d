      const SB_URL = "https://rcvtbmymewzrfrlabsbv.supabase.co";
// هذا مفتاح Supabase publishable فقط، وليس service_role. يجب تفعيل RLS كما في ملف SQL المرفق.
const SB_KEY = "sb_publishable_LkDqEApbom-4E66DdiZQag_VYA2gyWr";
let sb = null;
let isAdminAuthenticated = false;

async function initStore() {
  try {
    if (!window.supabase || !window.supabase.createClient) throw new Error("تعذر تحميل مكتبة الاتصال. تحققي من الإنترنت ثم أعيدي المحاولة.");
    sb = window.supabase.createClient(SB_URL, SB_KEY, {
      auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true }
    });
    const [{ data: store, error: storeError }, { data: authData, error: authError }] = await Promise.all([
      sb.from("store_data").select("html_content,logo_url").eq("id", 1).maybeSingle(),
      sb.auth.getSession()
    ]);
    if (storeError) console.warn("تعذر تحميل بيانات المتجر:", storeError.message);
    if (store && store.html_content) document.getElementById("editable-main").innerHTML = store.html_content;
    if (store && store.logo_url) {
      const logo = document.getElementById("site-logo");
      logo.src = store.logo_url; logo.style.display = "block";
    }
    if (authError) console.warn("تعذر التحقق من جلسة الإدارة:", authError.message);
    isAdminAuthenticated = !!(authData && authData.session);
    if (isAdminAuthenticated) enableAdminUI();
    sb.auth.onAuthStateChange((_event, session) => {
      isAdminAuthenticated = !!session;
      if (isAdminAuthenticated) enableAdminUI();
      else disableAdminUI();
    });
  } catch (e) {
    console.error("تعذر تهيئة المتجر:", e);
    alert(e.message || "تعذر الاتصال بقاعدة البيانات.");
  }
}
window.addEventListener("DOMContentLoaded", initStore);

function enableAdminUI() {
  if (!isAdminAuthenticated && sb) return;
  document.body.classList.add("admin-mode");
  document.querySelectorAll('#editable-main [data-edit="1"]').forEach(el => {
    if (!el.querySelector("button, select, input, textarea")) el.setAttribute("contenteditable", "true");
  });
}
function disableAdminUI() {
  document.body.classList.remove("admin-mode");
  document.querySelectorAll("[contenteditable]").forEach(el => el.removeAttribute("contenteditable"));
}

async function unlockAdmin() {
  if (isAdminAuthenticated) {
    if (document.body.classList.contains("admin-mode")) disableAdminUI();
    else enableAdminUI();
    return;
  }
  document.getElementById("login-modal").style.display = "flex";
}

async function loginAdmin() {
  try {
    if (!sb) return alert("المتجر ما زال يتصل بالخادم. أعيدي المحاولة بعد لحظات.");
    const email = document.getElementById("adm-email").value.trim();
    const password = document.getElementById("adm-pass").value;
    if (!email || !password) return alert("أدخلي البريد الإلكتروني وكلمة المرور.");
    const { data, error } = await sb.auth.signInWithPassword({ email, password });
    if (error) throw error;
    isAdminAuthenticated = !!(data && data.session);
    if (!isAdminAuthenticated) throw new Error("لم يتم إنشاء جلسة دخول.");
    closeAll(); enableAdminUI();
    document.getElementById("adm-pass").value = "";
    alert("تم تسجيل الدخول إلى لوحة الإدارة.");
  } catch (e) { alert("تعذر تسجيل الدخول: " + (e.message || "خطأ غير معروف")); }
}

async function publishToCloud() {
  const btn = document.getElementById("admin-save-btn") || document.getElementById("save-cloud-btn");
  if (!sb) return alert("الاتصال بقاعدة البيانات غير جاهز. أعيدي تحميل الصفحة.");
  const { data: sessionData, error: sessionError } = await sb.auth.getSession();
  if (sessionError || !sessionData || !sessionData.session) {
    isAdminAuthenticated = false; disableAdminUI();
    return alert("انتهت جلسة الإدارة. سجّلي الدخول من جديد قبل الحفظ.");
  }
  const oldText = btn ? btn.innerText : "";
  if (btn) { btn.disabled = true; btn.innerText = "جاري الحفظ..."; }
  try {
    const main = document.getElementById("editable-main");
    const editable = [...main.querySelectorAll("[contenteditable]")];
    editable.forEach(el => el.removeAttribute("contenteditable"));
    const html_content = main.innerHTML;
    const logo = document.getElementById("site-logo");
    const logo_url = logo && logo.style.display !== "none" ? logo.src : "";
    const { error } = await sb.from("store_data").upsert({ id: 1, html_content, logo_url, updated_at: new Date().toISOString() }, { onConflict: "id" });
    if (error) throw error;
    alert("تم حفظ التعديلات بنجاح. افتحي رابط الموقع في نافذة جديدة للتأكد من ظهورها للزبائن.");
  } catch (e) {
    alert("لم يتم الحفظ: " + (e.message || "خطأ غير معروف") + "\nتحققي من إعداد RLS ومعرّف حساب الإدارة في Supabase.");
  } finally {
    if (isAdminAuthenticated) enableAdminUI();
    if (btn) { btn.disabled = false; btn.innerText = oldText || "☁ حفظ ونشر التعديلات"; }
  }
}
async function adminLogout() {
  try { if (sb) { const { error } = await sb.auth.signOut(); if (error) throw error; } }
  catch (e) { alert("تعذر تسجيل الخروج: " + e.message); return; }
  isAdminAuthenticated = false; disableAdminUI();
  alert("تم تسجيل الخروج من الإدارة.");
}

